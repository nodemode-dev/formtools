{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The window shows the page the engine serves on 127.0.0.1, a remote origin to Tauri, so this capability lists that address and every app command has an allow permission generated from build.rs.",
  "windows": ["splash", "main"],
  "remote": { "urls": ["http://127.0.0.1:*"] },
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-request-user-attention",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-is-maximized",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-set-decorations",
    "core:window:allow-set-title",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "opener:allow-reveal-item-in-dir",
    "allow-app-ready",
    "allow-text-edit",
    "allow-pick-folder",
    "allow-pick-files",
    "allow-reveal-in-folder",
    "allow-open-with-default"
  ]
}
