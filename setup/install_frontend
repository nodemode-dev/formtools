#!/usr/bin/env bash
set -e
source "$(dirname "$0")/lib.sh"
cd "$FORMTOOLS_ROOT/frontend"
command -v npm >/dev/null 2>&1 || ft_die "npm not found, install Node 22 LTS"
if [ -f package-lock.json ]; then
  ft_say "npm ci"
  npm ci
else
  ft_say "no package-lock.json, running npm install"
  npm install
fi
ft_say "frontend ready"
