#!/usr/bin/env bash
set -e
source "$(dirname "$0")/lib.sh"
FT_EXTRA_HIDDEN_IMPORTS=()
if [ -n "${FORMTOOLS_HIDDEN_IMPORTS:-}" ]; then
  for m in $FORMTOOLS_HIDDEN_IMPORTS; do FT_EXTRA_HIDDEN_IMPORTS+=("$m"); done
fi
sign_engine() {
  local ent="$FORMTOOLS_ROOT/src-tauri/entitlements.plist" f info signed=0 kept=0
  local files=() sign_args=()
  [ -f "$ent" ] && sign_args+=(--entitlements "$ent")
  while IFS= read -r f; do
    if file -b "$f" | grep -Eq 'Mach-O.*(executable|shared library|bundle)'; then files+=("$f"); fi
  done < <(find "$1" -type f | awk -F/ '{print NF "\t" $0}' | sort -rn | cut -f2-)
  for f in "${files[@]}"; do
    info="$(codesign -d --verbose=4 "$f" 2>&1 || true)"
    if printf '%s\n' "$info" | grep -q '^Timestamp=' \
      && printf '%s\n' "$info" | grep -Eq '^CodeDirectory .*flags=[^ ]*runtime' \
      && ! printf '%s\n' "$info" | grep -q '^Signature=adhoc' \
      && codesign -d --entitlements - "$f" 2>/dev/null | grep -q 'com.apple.security.cs.disable-library-validation'; then
      kept=$((kept + 1))
      continue
    fi
    codesign --force --timestamp --options runtime "${sign_args[@]}" --sign "$APPLE_SIGNING_IDENTITY" "$f"
    signed=$((signed + 1))
  done
  for f in "${files[@]}"; do codesign --verify "$f" || ft_die "engine file failed its signature check: $f"; done
  ft_say "engine signed: ${#files[@]} Mach-O files, $signed signed here, $kept already signed by PyInstaller"
}
ft_rust_env
ft_venv
python -c "import PyInstaller" 2>/dev/null || ft_die "PyInstaller missing, run ./formtools install-desktop"
[ -f "$FORMTOOLS_ROOT/frontend/dist/index.html" ] || "$FORMTOOLS_ROOT/setup/build_frontend"
cd "$FORMTOOLS_ROOT/backend"
sep=":"
[ "$(ft_os)" = windows ] && sep=";"
ext="$(ft_exe)"
src="$(ft_native_path "$FORMTOOLS_ROOT")"
extra=()
[ -z "${FORMTOOLS_PYI_ARCH:-}" ] || extra+=(--target-arch "$FORMTOOLS_PYI_ARCH")
for m in ${FT_EXTRA_HIDDEN_IMPORTS[@]+"${FT_EXTRA_HIDDEN_IMPORTS[@]}"}; do extra+=(--hidden-import "$m"); done
if [ "$(ft_os)" = macos ]; then
  if [ -n "${APPLE_SIGNING_IDENTITY:-}" ]; then
    extra+=(--codesign-identity "$APPLE_SIGNING_IDENTITY")
    [ ! -f "$FORMTOOLS_ROOT/src-tauri/entitlements.plist" ] || extra+=(--osx-entitlements-file "$FORMTOOLS_ROOT/src-tauri/entitlements.plist")
  fi
fi
rm -rf build/pyinstaller dist-engine
PYTHONPATH="$src/backend${PYTHONPATH:+:$PYTHONPATH}" pyinstaller --noconfirm --clean --onedir --name formtools-engine \
  --distpath dist-engine --workpath build/pyinstaller --specpath build/pyinstaller \
  --add-data "$src/frontend/dist${sep}ui" \
  --paths "$src/backend" \
  --collect-submodules app --collect-submodules uvicorn \
  --hidden-import OpenEXR --hidden-import rawpy --hidden-import psd_tools \
  --collect-submodules fontTools --collect-submodules trimesh --collect-submodules send2trash \
  --hidden-import libarchive --hidden-import zstandard --hidden-import blake3 --hidden-import xxhash --hidden-import psutil \
  ${extra[@]+"${extra[@]}"} \
  "$src/backend/formtools_engine.py"
out="$FORMTOOLS_ROOT/src-tauri/engine"
rm -rf "$out"
cp -R dist-engine/formtools-engine "$out"
if [ "$(ft_os)" = macos ] && [ -n "${APPLE_SIGNING_IDENTITY:-}" ]; then sign_engine "$out"; fi
"$out/formtools-engine${ext}" --selfcheck
ft_say "engine folder ready: $out"
