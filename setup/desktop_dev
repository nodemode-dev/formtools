#!/usr/bin/env bash
set -e
source "$(dirname "$0")/lib.sh"
ft_rust_env
command -v rustc >/dev/null 2>&1 || ft_die "rustc not found; run ./formtools install-desktop"
[ -x "$FORMTOOLS_ROOT/src-tauri/engine/formtools-engine$(ft_exe)" ] || "$FORMTOOLS_ROOT/setup/freeze_backend"
cd "$FORMTOOLS_ROOT"
exec "$FORMTOOLS_ROOT/frontend/node_modules/.bin/tauri" dev "$@"
