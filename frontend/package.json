{
  "name": "formtools",
  "version": "0.7.0",
  "description": "Viewers, batch image tools and file utilities for the Form family",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "demo": "vite build --config vite.demo.config.ts --mode photos && vite build --config vite.demo.config.ts --mode family && vite build --config vite.demo.config.ts --mode bench",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-clipboard-manager": "2.5.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "highlight.js": "11.12.0",
    "markdown-it": "15.0.3",
    "pdfjs-dist": "6.5.438",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@types/markdown-it": "14.2.0",
    "@types/three": "0.187.0",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
